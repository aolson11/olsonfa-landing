{
  "rewrites": [
    {"source": "/thankyou", "destination": "/thankyou.html"},
    {"source": "/guide", "destination": "/guide.html"},
    {"source": "/(.*)", "destination": "/index.html"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
