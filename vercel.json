{
  "rewrites": [
    { "source": "/thankyou", "destination": "/thankyou.html" },
    { "source": "/guide", "destination": "/guide.html" },
    { "source": "/assessment", "destination": "/assessment.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/blog/(.*)", "destination": "/blog/$1.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
