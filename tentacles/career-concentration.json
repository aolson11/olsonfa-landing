{
  "$schema": "./tentacle.schema.json",
  "id": "career_concentration_check",
  "formId": "career-control-form",
  "campaignId": "employment_concentration_ai_layoff_2026q3",
  "route": { "path": "/career-control", "canonical": "https://olsonfa.com/career-control" },
  "metrics": { "start": "career_concentration_start", "preview": "career_concentration_preview", "capture": "career_concentration_capture", "success": "career_concentration_success" },
  "bands": [
    { "id": "monitor", "min": 0, "label": "Monitor, do not manufacture urgency", "summary": "Your answers do not point to a reason for urgency. Keep watching the variables that matter and strengthen your options deliberately." },
    { "id": "concentrated", "min": 7, "label": "Concentrated, build optionality", "summary": "A meaningful share of your working future sits with one employer. Building options can be useful without abandoning a role that still works." },
    { "id": "control-gap", "min": 13, "label": "Control gap worth investigating", "summary": "Your current exposure and desired control are far enough apart to justify a structured comparison of possible paths." },
    { "id": "time-sensitive", "min": 19, "label": "Time-sensitive, not rush-worthy", "summary": "Your answers make timing relevant. Move promptly toward facts and options, not toward a rushed ownership decision." }
  ],
  "questions": [
    { "id": "income", "legend": "How much of your household income depends on your current employment?", "help": "Use the closest broad range.", "options": [
      { "value": "under-25", "label": "Less than 25%", "weight": 0 }, { "value": "25-49", "label": "25–49%", "weight": 1 }, { "value": "50-74", "label": "50–74%", "weight": 3, "driver": "household income concentration" }, { "value": "75-plus", "label": "75% or more", "weight": 5, "driver": "household income concentration" }
    ]},
    { "id": "changes", "legend": "What observable changes are happening at work?", "help": "Select all that apply.", "multi": true, "options": [
      { "value": "ai-workflow", "label": "AI workflow changes", "weight": 2, "driver": "AI workflow changes" }, { "value": "freeze-reorg", "label": "Hiring freeze or reorganization", "weight": 3, "driver": "a hiring freeze or reorganization" }, { "value": "compressed-scope", "label": "Compressed role scope or headcount", "weight": 3, "driver": "role or headcount compression" }, { "value": "narrowing", "label": "Narrowing advancement or compensation", "weight": 2, "driver": "narrowing advancement or compensation" }, { "value": "none", "label": "None of these", "weight": 0 }
    ]},
    { "id": "runway", "legend": "If this income stopped, how long before a major household decision would be forced?", "options": [
      { "value": "12-plus", "label": "More than 12 months", "weight": 0 }, { "value": "6-12", "label": "6–12 months", "weight": 1 }, { "value": "3-6", "label": "3–6 months", "weight": 3, "driver": "limited decision runway" }, { "value": "under-3", "label": "Less than 3 months", "weight": 5, "driver": "limited decision runway" }
    ]},
    { "id": "control", "legend": "What would you most like more control over?", "options": [
      { "value": "income-ceiling", "label": "Income ceiling", "weight": 2, "driver": "income ceiling" }, { "value": "schedule", "label": "Schedule", "weight": 2, "driver": "schedule control" }, { "value": "location", "label": "Location", "weight": 1, "driver": "location control" }, { "value": "role-continuity", "label": "Role continuity", "weight": 3, "driver": "role continuity" }, { "value": "asset", "label": "Asset creation", "weight": 2, "driver": "asset creation" }, { "value": "none", "label": "None of these", "weight": 0 }
    ]},
    { "id": "future", "legend": "Which future state are you considering now?", "options": [
      { "value": "strengthen", "label": "Strengthen my current role", "weight": 0 }, { "value": "change", "label": "Change employers", "weight": 1 }, { "value": "diversify", "label": "Diversify income", "weight": 2 }, { "value": "investigate", "label": "Investigate ownership", "weight": 2 }, { "value": "evaluate", "label": "Actively evaluate ownership", "weight": 3 }
    ]},
    { "id": "timing", "legend": "What timing applies to this decision?", "options": [
      { "value": "none", "label": "No deadline", "weight": 0 }, { "value": "12-months", "label": "Within 12 months", "weight": 1 }, { "value": "6-months", "label": "Within 6 months", "weight": 3, "driver": "a six-month decision horizon" }, { "value": "under-way", "label": "Disruption is already under way", "weight": 5, "driver": "disruption already under way" }
    ]}
  ]
}
